{
  "expo": {
    "name": "Ecogrupo",
    "slug": "Ecogrupo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/Ecogrupo.png",
    "scheme": "ecogrupo",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
  "backgroundColor": "#E6F4FE",
  "foregroundImage": "./assets/images/Ecogrupo.png"
},
      "predictiveBackGestureEnabled": false
    },
    "web": {
  "output": "single",
  "favicon": "./assets/images/Ecogrupo.png"
},
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
